# docker-compose 용 환경변수 — 이 파일을 .env 로 복사해 값 채우기 (.env 는 커밋 금지)
LMS_DB_NAME=lms
LMS_DB_USER=lms
LMS_DB_PASSWORD=바꿔주세요-강한-비밀번호
# 개인정보 AES-256 키. 최초 설정 후 절대 변경 금지(기존 데이터 복호화 불가). 안전한 곳에 백업.
LMS_CRYPTO_SECRET=바꿔주세요-32자-이상-무작위-문자열
# 초기 관리자(admin) 비밀번호. 비워두면 첫 기동 시 무작위 생성되어 앱 로그에 1회 출력.
LMS_ADMIN_INIT_PASSWORD=
# 외부 노출 포트
LMS_HTTP_PORT=8080

# ── AI(Claude) 연동 ───────────────────────────────────────────────
# 키는 이 파일이 아니라 .env 에만 넣는다(.env 는 .gitignore 등록됨).
# 비워두면 AI 기능은 자동으로 꺼진 채 뜨고, 화면에 안내 문구가 나온다 — 앱은 정상 기동한다.
LMS_AI_ENABLED=false
ANTHROPIC_API_KEY=
# 모델 id (기본 claude-sonnet-5)
LMS_AI_MODEL=claude-sonnet-5
# 비용 상한. 0 이면 무제한 — 운영에서 0 은 권장하지 않는다.
LMS_AI_DAILY_LIMIT=500
LMS_AI_DAILY_LIMIT_PER_USER=50
