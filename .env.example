# docker-compose 용 환경변수 — 이 파일을 .env 로 복사해 값 채우기 (.env 는 커밋 금지)
LMS_DB_NAME=lms
LMS_DB_USER=lms
LMS_DB_PASSWORD=바꿔주세요-강한-비밀번호
# 개인정보 AES-256 키. 최초 설정 후 절대 변경 금지(기존 데이터 복호화 불가). 안전한 곳에 백업.
LMS_CRYPTO_SECRET=바꿔주세요-32자-이상-무작위-문자열
# 초기 관리자(admin) 비밀번호. 비워두면 첫 기동 시 무작위 생성되어 앱 로그에 1회 출력.
LMS_ADMIN_INIT_PASSWORD=
# 외부 노출 포트
LMS_HTTP_PORT=8080

# ── AI(Claude) 연동 ───────────────────────────────────────────────
# 키는 이 파일이 아니라 .env 에만 넣는다(.env 는 .gitignore 등록됨).
# 비워두면 AI 기능은 자동으로 꺼진 채 뜨고, 화면에 안내 문구가 나온다 — 앱은 정상 기동한다.
LMS_AI_ENABLED=false
ANTHROPIC_API_KEY=
# 모델 id (기본 claude-sonnet-5)
LMS_AI_MODEL=claude-sonnet-5
# 비용 상한. 0 이면 무제한 — 운영에서 0 은 절대 권장하지 않는다.
# 기본값은 보수적으로 잡았다. 부족하면 올리면 되지만, 처음부터 크게 잡으면
# 사고가 났을 때 금액이 커진 뒤에야 알게 된다.
LMS_AI_DAILY_LIMIT=200
LMS_AI_DAILY_LIMIT_PER_USER=20
# 답변 길이 상한. 출력 토큰이 입력보다 비싸서 여기가 비용에 가장 크게 듣는다.
LMS_AI_MAX_TOKENS=600


# ── 채용공고 수집 (사람인 오픈 API) ──────────────────────────────
# [기능 1] 직무 로드맵의 원천 데이터. 매주 월요일 03:00 자동 수집.
# 키 발급: https://oapi.saramin.co.kr (기업회원 → 오픈API 신청)
# 비워두면 수집기가 돌지 않고 로드맵 화면은 "아직 수집 전"을 보여준다 — 앱은 정상 기동.
LMS_JOB_ENABLED=false
SARAMIN_ACCESS_KEY=
# 수집 주기 (기본: 매주 월요일 새벽 3시)
LMS_JOB_CRON=0 0 3 * * MON

# ── Cloudflare Tunnel (lms.samsungax.com 외부 공개) ──────────────
# Zero Trust > Networks > Tunnels & Mesh > lxp 터널의 커넥터 토큰.
# 이 값이 없으면 cloudflared 컨테이너가 기동하지 않는다.
TUNNEL_TOKEN=
